# Choose ONE provider: anthropic (paid) | gemini (free tier) | groq (free tier) | ollama (local, free)
LLM_PROVIDER=gemini
MODEL_NAME=gemini-2.0-flash

# Keys (fill only the one you use)
GOOGLE_API_KEY=your-google-ai-studio-key
GROQ_API_KEY=
ANTHROPIC_API_KEY=

OPENALEX_EMAIL=you@example.com

# Free tiers have rate limits: keep 1 worker and a delay between calls
SCREEN_WORKERS=1
LLM_MIN_INTERVAL=4
MAX_INCLUDED=15
MAX_RECORDS=30
